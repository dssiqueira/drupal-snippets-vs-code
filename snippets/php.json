			"[",
			"  '#theme' => '${1:item_list}',",
			"  '#${2:items}' => ${3:\\$items},",
			"  '#cache' => [",
			"    'tags' => [${4:'node_list'}],",
			"    'contexts' => [${5:'url.path'}],",
			"  ],",
			"]"
		]
	},
	"Cache metadata": {
		"prefix": "drupal_cache_metadata",
		"description": "#cache key for a render array.",
		"body": [
			"'#cache' => [",
			"  'contexts' => [${1:'user.permissions'}],",
			"  'tags' => [${2:'node_list'}],",
			"  'max-age' => ${3:\\Drupal\\Core\\Cache\\Cache::PERMANENT},",
			"],"
		]
	},
	"Cache get/set": {
		"prefix": "drupal_cache",
		"description": "Read from the cache, computing and storing the value on a miss.",
		"body": [
			"\\$cid = '${1:mymodule:key}';",
			"if (\\$cache = \\Drupal::cache()->get(\\$cid)) {",
			"  \\$data = \\$cache->data;",
			"}",
			"else {",
			"  \\$data = ${2:\\$this->compute()};",
			"  \\Drupal::cache()->set(\\$cid, \\$data, \\Drupal\\Core\\Cache\\CacheBackendInterface::CACHE_PERMANENT, [${3:'node_list'}]);",
			"}"
		]
	},
	"Batch": {
		"prefix": "drupal_batch",
		"description": "Start a batch with BatchBuilder.",
		"body": [
			"\\$batch = (new \\Drupal\\Core\\Batch\\BatchBuilder())",
			"  ->setTitle(t('${1:Processing}'))",
			"  ->setFinishCallback([${2:static::class}, '${3:batchFinished}'])",
			"  ->addOperation([${2}, '${4:batchProcess}'], [${5:\\$items}]);",
			"batch_set(\\$batch->toArray());"
		]
	},
	"Access result": {
		"prefix": "drupal_access_result",
		"description": "Return an AccessResult based on a permission.",
		"body": [
			"return \\Drupal\\Core\\Access\\AccessResult::allowedIfHasPermission(\\$${1:account}, '${2:access content}');"
		]
	}
}
